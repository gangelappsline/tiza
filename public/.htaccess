# ---------------------------------------------------------------------------
# Tiza · configuración para Apache / cPanel
# Copia este archivo junto con el contenido de "dist/" en public_html.
# ---------------------------------------------------------------------------

<IfModule mod_negotiation.c>
  Options -MultiViews -Indexes
</IfModule>
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # (Opcional) Forzar HTTPS. Descomenta si tu hosting no lo hace ya.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA: cualquier ruta que no sea un archivo o carpeta real se sirve con
  # index.html para que React Router la resuelva (evita el error 404 al abrir
  # o recargar /login, /juegos/nave, etc.).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Tipos MIME
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# Caché: los archivos con hash (generados por Vite) nunca cambian; index.html
# siempre se revalida para que los usuarios reciban las nuevas versiones.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|webp|avif|svg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
